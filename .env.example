# Copier en .env.local, ou mieux : `vercel env pull .env.local` remplit tout automatiquement.

# Base Postgres (Neon, installée par la place de marché Vercel)
DATABASE_URL=

# Accès aux modèles : en local, jeton OIDC fourni par `vercel env pull` (valable 12 h) ;
# sinon une clé créée dans le tableau de bord Vercel, onglet AI Gateway.
VERCEL_OIDC_TOKEN=
# AI_GATEWAY_API_KEY=

# Code d'accès de la démo en ligne. Laisser vide en local : l'accès est libre.
DEMO_ACCESS_CODE=

# Modèle par tâche (facultatif) : les valeurs par défaut sont dans lib/ai/models.ts.
# MODEL_EXTRACT=anthropic/claude-sonnet-5.5
# MODEL_CONFIRM=anthropic/claude-sonnet-5.5
# MODEL_SYNTHESIZE=anthropic/claude-sonnet-5.5
# MODEL_PRESCORE=anthropic/claude-sonnet-5.5
# MODEL_AGENT=anthropic/claude-opus-5.5
# MODEL_STORY=anthropic/claude-sonnet-5.5
# MODEL_JUDGE=openai/gpt-5
# MODEL_EMBED=openai/text-embedding-3-small
